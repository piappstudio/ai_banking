		{
			"name": "Transactions",
			"item": [
				{
					"name": "Initiate Transfer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success) {",
									"    pm.environment.set(\"verification_id\", jsonData.data.verification_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "json",
							"json": {
								"from_account_id": 1,
								"to_account_id": 2,
								"amount": 100.00,
								"description": "Test Transfer"
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/transactions/transfer",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "transactions", "transfer"]
						}
					}
				},
				{
					"name": "Authorize Transfer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "json",
							"json": {
								"verification_id": "{{verification_id}}",
								"code": "123456"
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/transactions/authorize",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "transactions", "authorize"]
						}
					}
				}
			]
		},
